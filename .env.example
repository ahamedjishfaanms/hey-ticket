# --- Neon (Postgres database) ---
# Neon dashboard -> your project -> Connection Details -> copy the
# "pooled connection" string. Looks like:
# postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- Clerk (auth) ---
# Clerk dashboard -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- App ---
# The public URL of your deployed app (used in emails + QR ticket links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ---
# Sign up free at https://resend.com, verify a sending domain, create an API key
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="HeyTicket <tickets@yourdomain.com>"

# --- Cron security ---
# Random secret string you invent, used to protect the /api/reminders cron endpoint
CRON_SECRET=change-me-to-a-long-random-string
